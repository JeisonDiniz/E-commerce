# Copie para .env e ajuste os valores para o seu ambiente local.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_ml

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=troque-esta-chave-em-producao-para-um-valor-aleatorio-longo
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS (origens do front-end React, separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ambiente ("development" ou "production"). Em produção, o boot falha se
# SECRET_KEY ainda for o valor padrão do repositório.
ENVIRONMENT=development

# Armazenamento de imagens de produto. "local" grava em disco (MEDIA_ROOT) e
# serve pela própria API em MEDIA_BASE_URL — suficiente para dev/TCC. No
# deploy, troque para um backend de nuvem implementando-o em
# app/core/storage.py.
STORAGE_BACKEND=local
MEDIA_ROOT=static/uploads
MEDIA_BASE_URL=/media
MAX_UPLOAD_SIZE_MB=5

# Cache de predições ML (segundos)
ML_PREDICTION_CACHE_TTL=3600

# URL do front-end (usada para montar o link de "esqueci minha senha")
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# E-mail (opcional). Deixe em branco para só logar o link no console do
# back-end (modo desenvolvimento/demonstração, sem precisar de um provedor real).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@loja.com

# Frete (Melhor Envio) — crie uma conta sandbox em melhorenvio.com.br e gere
# um token de aplicativo. Sem isso, POST /shipping/quote responde 503.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_CEP_ORIGEM=01310-100

# Pagamento (Mercado Pago) — crie uma aplicação de teste em
# mercadopago.com.br/developers e use as credenciais de TESTE (sandbox).
# MERCADO_PAGO_PUBLIC_KEY é exposta ao front (não é segredo, é assim que o
# SDK de tokenização de cartão funciona). As outras duas são secretas.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
