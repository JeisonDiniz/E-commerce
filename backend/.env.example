# Copie para .env e ajuste os valores para o seu ambiente local.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_ml

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=troque-esta-chave-em-producao-para-um-valor-aleatorio-longo
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# CORS (origens do front-end React, separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cache de predições ML (segundos)
ML_PREDICTION_CACHE_TTL=3600

# URL do front-end (usada para montar o link de "esqueci minha senha")
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# E-mail (opcional). Deixe em branco para só logar o link no console do
# back-end (modo desenvolvimento/demonstração, sem precisar de um provedor real).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@loja.com
